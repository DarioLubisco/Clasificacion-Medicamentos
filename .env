# ============================================================
# .ENV — Configuracion unica del pipeline de clasificacion
# No tocar los .py para experimentar. Editar aqui.
#
# Las credenciales (API keys, DB passwords) viven en:
#   ../../N8N/synapse.credentials  (cargadas por synapse_cred.py)
# ============================================================

# === CREDENCIALES ===
CREDENCIALES_ARCHIVO=../../N8N/synapse.credentials
DB_SERVER=100.94.5.108,49751       # sobreescribe synapse.credentials (instance name falla con pyodbc)

# === MODO DE EJECUCION ===
DRY_RUN=false                    # true = solo prepara, sin APIs | false = motores reales
SALIDA_DIRECTORIO=scratch
SALIDA_ARCHIVO=experimento_resultados.json

# === LOGGING ===
LOG_ACTIVAR=true                 # false = solo stdout, sin archivos
LOG_JSON=false                   # true = genera .jsonl estructurado | false = solo .log legible

# === SELECCION DE PRODUCTOS (DB REAL) ===
NUM_PRODUCTOS=5                  # 0 = todos los que cumplan el filtro
EANS=7590005162832,7590005168810,7592904000017,7592247000224,7591309000080
FILTRO_WHERE=estado_ciclo='ABIERTO'

# === MODELO IA PRINCIPAL (ACTIVO) ===
IA_PROVEEDOR=deepseek             # glm | deepseek → selecciona modelo de texto principal
IA_MODELO=deepseek-v4-flash       # modelo activo (DeepSeek V4 Flash nativo)
IA_MAX_TOKENS=4000
IA_TEMPERATURE=0.7              # corregido: 0.2 era de Gemma. GLM-4.7 recomienda 0.7
IA_TOP_P=0.95                   # corregido: 0.9 era de Gemma. GLM-4.7 recomienda 0.95

# === MODELO IA SECUNDARIO (INACTIVO / STANDBY) ===
IA_PROVEEDOR_SECUNDARIO=deepseek
IA_MODELO_SECUNDARIO=deepseek-v4-flash
IA_MAX_TOKENS_SECUNDARIO=16384
IA_TEMPERATURE_SECUNDARIO=0.2

# === VISION ===
VISION_ACTIVAR=true
VISION_PROVEEDOR=mimo           # mimo | openrouter
VISION_MODELO=mimo-v2.5
VISION_API_URL=https://token-plan-sgp.xiaomimimo.com/v1
VISION_THINKING=disabled
VISION_ACTIVA=1                 # 1=visión activa, 0=sin visión
VISION_MAX_PREFILTRO=10         # max imagenes a pasar al pre-filtro
VISION_MAX_OCR=4                # max imagenes aprobadas para OCR
VISION_UMBRAL=3                 # score min (0-5) para aprobar imagen

# === FOTOS E IMAGENES ===
MAX_FOTOS_TOTALES=10            # tope de imagenes descargadas por producto (scraper)
MAX_FOTOS_PREFILTRO=10          # max imagenes a evaluar legibilidad (pre-filtro)
MAX_FOTOS_OCR=4                 # max imagenes a extraer texto (OCR) — debe llegar a 4
UMBRAL_LEGIBILIDAD=3            # score min (0-5) para aprobar una foto

# === CONSENSO DE IMAGENES (sobrescribe EAN si N fotos coinciden) ===
CONSENSO_IMAGENES_DESCRIPCION=3  # mas conservador: 3 fotos deben coincidir
CONSENSO_IMAGENES_FORMA=2       # legible en el empaque
CONSENSO_IMAGENES_CONCENTRACION=2

# === SCRAPING WEB ===
MAX_FUENTES_WEB=10              # max URLs a buscar por producto
SCRAPING_DELAY=0.5             # segundos entre requests
SCRAPING_REINTENTOS=3           # reintentos de busqueda
SCRAPING_TEXTO_MAX=8000         # max caracteres extraidos por pagina

# === TIMEOUTS (segundos) ===
TIMEOUT_VISION=120              # MiMo / OpenRouter (OCR + pre-filtro)
TIMEOUT_TEXTO=300              # GLM / DeepSeek (consolidacion LLM)
TIMEOUT_RED=25                 # descarga imagenes + scraping + DB (ValueSERP mide 7-15s)

# === CICLO DE REPROCESO ===
SCORE_CIERRE=88                # score min para cerrar un medicamento
SCORE_CIERRE_NO_MED=70        # score min para cerrar un no-medicamento
MAX_REINTENTOS=3              # ciclos max antes de AGOTADO
BATCH_SIZE=5                 # productos por corrida

# === PROMPT Y TAXONOMIAS ===
PROMPT_ARCHIVO=prompt_agente_v3_solidificado_final.txt
TAXONOMIAS_CACHE=scratch/taxonomias_local.txt
